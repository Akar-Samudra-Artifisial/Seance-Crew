{
  "name": "@seance-crew/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Séance Crew dashboard page (Kiro Crew app UI bundle). @kirocrew/app-sdk stays a peer dependency: it is provided by the host and is not on npm, so installs outside pnpm use `npm install --legacy-peer-deps`.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node ../scripts/build.mjs ui",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "@kirocrew/app-sdk": "*",
    "lucide-react": "*"
  },
  "peerDependenciesMeta": {
    "@kirocrew/app-sdk": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    }
  }
}
